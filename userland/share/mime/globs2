# File-name patterns for content types, in the format of freedesktop.org's
# shared-mime-info (weight:type:glob), read by GIO's xdgmime when
# WebKit opens file:// URLs. A subset for the web's common types; the full
# shared-mime-info database can replace it.
50:text/html:*.html
50:text/html:*.htm
50:application/xhtml+xml:*.xhtml
50:text/css:*.css
50:text/javascript:*.js
50:text/javascript:*.mjs
50:application/json:*.json
50:application/xml:*.xml
50:image/svg+xml:*.svg
50:image/png:*.png
50:image/jpeg:*.jpg
50:image/jpeg:*.jpeg
50:image/gif:*.gif
50:image/webp:*.webp
50:image/x-icon:*.ico
50:font/woff2:*.woff2
50:font/woff:*.woff
50:font/ttf:*.ttf
50:font/otf:*.otf
50:text/plain:*.txt
50:application/pdf:*.pdf
50:application/wasm:*.wasm
