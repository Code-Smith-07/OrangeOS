# Meson cross file for OrangeOS userland libraries (WPE WebKit trial).
# tools/wpe/build_deps.py fills in the absolute paths.
#
# OrangeOS runs Linux/musl programs built from source through its musl
# translation layer, so the host machine is described as Linux: that is the
# ABI the libraries are compiled for. Nothing built here runs on the Mac.

[binaries]
c = '@BIN@/orange-cc'
cpp = '@BIN@/orange-c++'
ar = '@BIN@/orange-ar'
ranlib = '@BIN@/orange-ranlib'
strip = '/usr/bin/true'
pkg-config = '@VENV_BIN@/pkg-config'

[host_machine]
system = 'linux'
kernel = 'linux'
cpu_family = 'x86_64'
cpu = 'x86_64'
endian = 'little'

[properties]
needs_exe_wrapper = true
pkg_config_libdir = ['@SYSROOT@/lib/pkgconfig']
# Answers for checks GLib would otherwise run on the target (musl 1.2.5).
have_c99_vsnprintf = true
have_c99_snprintf = true
have_unix98_printf = true
growing_stack = false
