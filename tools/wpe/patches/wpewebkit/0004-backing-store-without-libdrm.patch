OrangeOS: build the WPE backing store without libdrm.

getImageInfoFromBuffer() compares with DRM_FORMAT_XRGB8888, which was only
declared when building for Android or with libdrm. Without libdrm, take the
format codes from the kernel header <drm/drm_fourcc.h>, as Android does.

diff -ru a/Source/WebKit/UIProcess/wpe/AcceleratedBackingStore.cpp b/Source/WebKit/UIProcess/wpe/AcceleratedBackingStore.cpp
--- a/Source/WebKit/UIProcess/wpe/AcceleratedBackingStore.cpp	2026-07-27 21:10:40
+++ b/Source/WebKit/UIProcess/wpe/AcceleratedBackingStore.cpp	2026-09-28 15:04:43
@@ -37,10 +37,11 @@
 #include <wtf/TZoneMallocInlines.h>
 #include <wtf/glib/GUniquePtr.h>
 
-#if OS(ANDROID)
-#include <drm/drm_fourcc.h>
-#elif USE(LIBDRM)
+#if USE(LIBDRM) && !OS(ANDROID)
 #include <drm_fourcc.h>
+#else
+// The format codes without libdrm: the kernel's own header.
+#include <drm/drm_fourcc.h>
 #endif
 
 WTF_IGNORE_WARNINGS_IN_THIRD_PARTY_CODE_BEGIN
