diff -ru a/Source/JavaScriptCore/jit/ExecutableAllocator.cpp b/Source/JavaScriptCore/jit/ExecutableAllocator.cpp
--- a/Source/JavaScriptCore/jit/ExecutableAllocator.cpp	2026-09-28 17:24:43
+++ b/Source/JavaScriptCore/jit/ExecutableAllocator.cpp	2026-09-28 17:25:33
@@ -61,6 +61,11 @@
 #include <wtf/cocoa/Entitlements.h>
 #endif
 
+#if ENABLE(SEPARATED_WX_HEAP) && OS(LINUX)
+#include <sys/mman.h>
+#include <unistd.h>
+#endif
+
 #if OS(DARWIN)
 #include <fcntl.h>
 #include <mach/mach.h>
@@ -352,6 +357,46 @@
 
 #endif // OS(DARWIN) && HAVE(REMAP_JIT)
 
+#if ENABLE(SEPARATED_WX_HEAP) && OS(LINUX)
+// OrangeOS (docs/design/012 §4.5): the kernel never maps memory writable and
+// executable at once. The JIT pool is one memfd mapped twice: read/execute
+// over the reservation, where code runs, and read/write at an address only
+// this file keeps, through which performJITMemcpy writes all code.
+// x86 has no execute-only pages, so unlike Darwin's thunk the writable
+// address lives in ordinary (static) memory.
+static uint8_t* s_jitWritableBase;
+static size_t s_jitWritableSize;
+
+static void jitWriteSeparateHeapsLinux(off_t offset, const void* src, size_t n)
+{
+    RELEASE_ASSERT(offset >= 0 && static_cast<size_t>(offset) <= s_jitWritableSize && n <= s_jitWritableSize - static_cast<size_t>(offset));
+WTF_ALLOW_UNSAFE_BUFFER_USAGE_BEGIN
+    memcpyAtomicIfPossible(s_jitWritableBase + offset, src, n);
+WTF_ALLOW_UNSAFE_BUFFER_USAGE_END
+}
+
+static bool initializeSeparatedWXHeaps(void*, size_t, void* jitBase, size_t jitSize)
+{
+    int fd = memfd_create("jsc-jit", MFD_CLOEXEC);
+    if (fd < 0)
+        return false;
+    auto closeDescriptor = makeScopeExit([fd] { close(fd); });
+    if (ftruncate(fd, static_cast<off_t>(jitSize)))
+        return false;
+    void* writable = mmap(nullptr, jitSize, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    if (writable == MAP_FAILED)
+        return false;
+    if (mmap(jitBase, jitSize, PROT_READ | PROT_EXEC, MAP_SHARED | MAP_FIXED, fd, 0) != jitBase) {
+        munmap(writable, jitSize);
+        return false;
+    }
+    s_jitWritableBase = static_cast<uint8_t*>(writable);
+    s_jitWritableSize = jitSize;
+    g_jscConfig.jitWriteSeparateHeaps = jitWriteSeparateHeapsLinux;
+    return true;
+}
+#endif // ENABLE(SEPARATED_WX_HEAP) && OS(LINUX)
+
 struct JITReservation {
     PageReservation pageReservation;
     void* base { nullptr };
@@ -425,7 +470,16 @@
             ASSERT(reservation.size >= executablePageSize() * 2);
             reservation.base = (void*)((uintptr_t)(reservation.base) + executablePageSize());
             reservation.size -= executablePageSize();
+#if OS(LINUX)
+            if (!initializeSeparatedWXHeaps(reservation.pageReservation.base(), executablePageSize(), reservation.base, reservation.size)) {
+                // No aliased memory: run without the JIT rather than with
+                // writable code.
+                reservation.pageReservation.deallocate();
+                return { };
+            }
+#else
             initializeSeparatedWXHeaps(reservation.pageReservation.base(), executablePageSize(), reservation.base, reservation.size);
+#endif
         }
 #endif
 
